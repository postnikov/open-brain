# Required: OpenAI API key for embeddings and metadata extraction
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Run ./setup.sh (local PostgreSQL) or ./setup.sh --env-only (Docker) to generate these.
# No shared default password. POSTGRES_PASSWORD must match the password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://open_brain:CHANGE_ME_DB_PASSWORD@localhost:5432/open_brain

# Server port (default: 3100)
PORT=3100
